      <column aggregation='None' caption='Age (bin)' datatype='integer' name='[Age (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[Calculation_2031123481777414144]' peg='0' size='5' />
      </column>
      <column aggregation='Sum' datatype='real' name='[BMI]' role='dimension' type='ordinal' />
      <column aggregation='Sum' caption='Age' datatype='integer' name='[Calculation_2031123481777414144]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='YEAR(TODAY())-[year]' />
      </column>
      <column caption='AgeGroup' datatype='string' name='[Calculation_2031123481781714945]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2031123481777414144]&lt;20 then &apos;0-20&apos;&#13;&#10;ELSEIF [Calculation_2031123481777414144]&lt;30 then &apos;20-30&apos;&#13;&#10;ELSEIF [Calculation_2031123481777414144]&lt;40 then &apos;30-40&apos;&#13;&#10;ELSEIF [Calculation_2031123481777414144]&lt;50 then &apos;40-50&apos;&#13;&#10;ELSEIF [Calculation_2031123481777414144]&lt;65 then &apos;50-65&apos;&#13;&#10;ELSE &apos;65+&apos;&#13;&#10;END' />
      </column>
      <column caption='BMI Range' datatype='string' name='[Calculation_2031123481785593858]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [BMI] &lt;18.5 then &apos;underweight&apos;&#13;&#10;ELSEIF  [BMI] &gt;=18.5 and [BMI]&lt;=24.9 then &apos;Healthy Weight&apos;&#13;&#10;ELSEIF [BMI]&gt;=25 and [BMI] &lt;=29.9 then &apos;Overweight&apos;&#13;&#10;ELSE &apos;Obese&apos;&#13;&#10;END' />
      </column>
      <column caption='Salutation' datatype='string' name='[Calculation_2031123481797226501]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRIM(MID([name],&#13;&#10;FIND([name],&apos;,&apos;)+2,&#13;&#10;FIND([name],&apos;.&apos;) - FIND([name],&apos;,&apos;)-1&#13;&#10;))' />
      </column>
      <column caption='Gender' datatype='string' name='[Calculation_2031123481799798790]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF TRIM([Calculation_2031123481797226501])=&apos;Mr.&apos; then &apos;Male&apos;&#13;&#10;ELSE &apos;Female&apos;&#13;&#10;END' />
      </column>
      <column caption='Charges (bin)' datatype='integer' name='[Charges (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='3' formula='[charges]' peg='0' size='1500' />
      </column>
